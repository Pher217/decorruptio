# Django
SECRET_KEY=dev-insecure-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (primary database per standard tech stack)
DATABASE_URL=postgresql://decorruptio:decorruptio@localhost:5432/decorruptio
# Tokenized-ID vault (ADR-000 G3) — REQUIRED; the vault refuses to start if blank.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
UNCORRUPT_VAULT_HMAC_KEY=
# FX-at-date rate source
FX_RATES_SOURCE=ecb
