# Postgres (clean store + Dagster storage)
DATABASE_URL=postgresql://uncorrupt:uncorrupt@localhost:5432/uncorrupt
# Raw zone (MinIO / S3-compatible), content-addressed write-once
RAW_STORE_URL=s3://uncorrupt-raw
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
# Dagster
DAGSTER_HOME=./dagster_home
# Tokenized-ID vault (ADR-000 G3) — REQUIRED; the vault refuses to start if blank.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
UNCORRUPT_VAULT_HMAC_KEY=
# FX-at-date rate source
FX_RATES_SOURCE=ecb
