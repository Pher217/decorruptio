# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
# Env & secrets
.env
# Local data & runtime
data/
dagster_home/
*.duckdb
# Experiment outputs (regenerated, not versioned).
# EXCEPTION: experiments/no_score_certificate.json is force-tracked
# (git add -f) despite this rule. ADR-008 requires the no-score certificate
# to be a permanent, auditable artifact naming exactly which control
# blocked scoring; its graph_hash binds it to a live, mutating Postgres
# database, so unlike every other file under experiments/ it cannot be
# regenerated identically once deleted -- an ignored, worktree-only copy
# would defeat the whole point of the certificate.
experiments/
# Node
node_modules/
dashboard/dist/
# OS
.DS_Store
decorruptio_dev.db

# graphify writes its output into the CWD — never let it land in the code repo.
# Canonical graph home is ~/dev/Graphify/{Project}/{repo}/ (see graphify-canonical.sh).
graphify-out/
.graphify_*

# playwright-mcp scratch output (downloaded registers, console logs)
.playwright-mcp/

# Claude Code local session state. Agent worktrees, scheduler locks and the
# next-session handoff are machine-local: the durable version of session state
# is the vault (02 Projects/Ideas/Decorruptio/03 Sessions/hot.md), per
# vault-as-source-of-truth. Skills/agents/plans stay trackable by design.
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/TOMORROW.md
